{
  "name": "panelize",
  "version": "0.1.2",
  "description": "A React layout kit: named panels, tracks, grid, and type, themed with createPanelizeTheme and PanelizeProvider.",
  "keywords": [
    "react",
    "layout",
    "styled-components",
    "ui",
    "design-system",
    "theme",
    "typescript"
  ],
  "homepage": "https://github.com/jayzizzle/panelize#readme",
  "bugs": {
    "url": "https://github.com/jayzizzle/panelize/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jayzizzle/panelize.git"
  },
  "license": "MIT",
  "author": "Jon Zamora",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "panelize": "./bin/panelize.mjs"
  },
  "main": "./dist/panelize.cjs",
  "module": "./dist/panelize.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/panelize.es.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/panelize.cjs"
      }
    },
    "./llms.txt": "./llms.txt",
    "./llms-full.txt": "./llms-full.txt",
    "./docs/*": "./docs/*",
    "./examples/*": "./examples/*",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "llms.txt",
    "llms-full.txt",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "examples"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "npm run clean && tsc -b && vite build && npm run build:types",
    "lint": "eslint .",
    "preview": "vite preview",
    "format": "prettier --write .",
    "llms-full": "node scripts/build-llms-full.mjs",
    "prepublishOnly": "npm run llms-full && npm run check",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:dist": "node scripts/check-dist.mjs",
    "check": "npm run lint && npx prettier --check . && npm run test && npm run build && npm run test:dist && npm run test:types",
    "test:types": "attw --pack . --entrypoints .",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:types": "node scripts/build-types.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "styled-components": "^6.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "dts-bundle-generator": "^9.5.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-relative-import-paths": "^1.7.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "styled-components": "^6.5.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
